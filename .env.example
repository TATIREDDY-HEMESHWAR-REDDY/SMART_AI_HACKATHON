# ── CampusOS ERP (Next.js) ───────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_os?schema=public"
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"
AI_PROVIDER="gemini"
AI_API_KEY="your-ai-provider-api-key"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minio-access-key"
STORAGE_SECRET_KEY="minio-secret-key"
CREDENTIAL_PRIVATE_KEY="your-base64-encoded-ecdsa-private-key"
CREDENTIAL_PUBLIC_KEY="your-base64-encoded-ecdsa-public-key"
BLOCKCHAIN_CONFIG='{"provider": "mock-tamper-evident-ledger", "network": "testnet"}'

# ── Career OS / Placement Portal (FastAPI + Vite) ────────────────────────────
CAREER_DATABASE_URL=sqlite:///./career_os.db
JWT_SECRET=supersecretkey_change_in_production
JWT_REFRESH_SECRET=supersecretrefreshkey_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
STUDENT_CONTEXT_MODE=mock
# Set to the ERP's base URL so Career OS can pull student data
ERP_API_URL=http://localhost:3001
# Career OS frontend origin (used for CORS)
FRONTEND_URL=http://localhost:5173
STORAGE_PROVIDER=local
