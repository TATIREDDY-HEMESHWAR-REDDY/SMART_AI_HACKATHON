# Application Environment (development, production, test)
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_os?schema=public"

# Authentication secret (JWT/session encryption key)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"

# AI Configuration (OpenAI, Anthropic, Gemini, etc.)
AI_PROVIDER="gemini" # gemini, openai, anthropic, or custom-local
AI_API_KEY="your-ai-provider-api-key"

# Secure Object Storage (S3 / MinIO for PDF credentials and resumes)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minio-access-key"
STORAGE_SECRET_KEY="minio-secret-key"

# Cryptographic Keys for Credential Issuance (ECDSA / RSASSA-PSS key pair)
# Generate a secure keypair for signing academic documents
CREDENTIAL_PRIVATE_KEY="your-base64-encoded-ecdsa-private-key"
CREDENTIAL_PUBLIC_KEY="your-base64-encoded-ecdsa-public-key"

# Blockchain/Ledger Configuration (mocked or testnet config)
# Can be local ledger or a mock provider URL/config for the hackathon MVP
BLOCKCHAIN_CONFIG='{"provider": "mock-tamper-evident-ledger", "network": "testnet"}'
