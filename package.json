{
  "name": "campus-os-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Campus OS - Hackathon Monorepo",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:ai": "pnpm --filter ai-service dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:seed": "pnpm --filter api exec prisma db seed"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
