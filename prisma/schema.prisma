generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  departments Department[]
}

model Department {
  id            String      @id @default(uuid())
  name          String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  programs      Program[]
  courses       Course[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Program {
  id           String           @id @default(uuid())
  name         String
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  students     StudentProfile[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  roles          UserRole[]
  studentProfile StudentProfile?
  facultyProfile FacultyProfile?

  refreshTokens RefreshToken[]
  complaints    Complaint[]
  notifications Notification[]
  Recruiter     Recruiter?
  AlumniProfile AlumniProfile?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., STUDENT, FACULTY, ADMIN
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // e.g., 'student.read.self'
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model StudentProfile {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNumber String  @unique
  firstName        String
  lastName         String
  programId        String
  program          Program @relation(fields: [programId], references: [id])
  currentSemester  Int     @default(1)
  cgpa             Float   @default(0.0)
  activeBacklogs   Int     @default(0)

  phone           String?
  skills          String[] @default([])
  interests       String[] @default([])
  certifications  String[] @default([])
  projects        String[] @default([])
  internships     String[] @default([])
  profilePhotoUrl String?
  careerGoal      String?

  enrollments CourseEnrollment[]
  attendance  AttendanceRecord[]
  examResults ExamResult[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  StudentSkill         StudentSkill[]
  CareerGoal           CareerGoal[]
  AssessmentResult     AssessmentResult[]
  CareerRecommendation CareerRecommendation[]
  ProjectSuggestion    ProjectSuggestion[]
  Resume               Resume[]
  JobApplication       JobApplication[]
  MentorshipRequest    MentorshipRequest[]
  Referral             Referral[]
  MockInterview        MockInterview[]
}

model FacultyProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String  @unique
  firstName   String
  lastName    String
  designation String
  department  String?

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// STAGE 1: ACADEMICS & ATTENDANCE
// ==========================================

model Course {
  id           String         @id @default(uuid())
  code         String         @unique // e.g., CSE3002
  name         String
  credits      Int            @default(3)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  facultyId    String
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id])

  enrollments CourseEnrollment[]
  sessions    ClassSession[]
  timetable   TimetableEntry[]
  assignments Assignment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseEnrollment {
  id        String         @id @default(uuid())
  courseId  String
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([courseId, studentId])
}

model ClassSession {
  id        String             @id @default(uuid())
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime
  topic     String?
  records   AttendanceRecord[]
  createdAt DateTime           @default(now())
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  session   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([sessionId, studentId])
}

// ==========================================
// MODULE D: ACADEMICS (NEW)
// ==========================================

model TimetableEntry {
  id        String  @id @default(uuid())
  dayOfWeek Int // 1=Monday, 5=Friday
  startTime String // e.g., "10:00"
  endTime   String // e.g., "11:30"
  roomId    String? // Room number/name
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  maxScore    Float    @default(100)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
}

model Exam {
  id       String       @id @default(uuid())
  name     String // e.g., "Midterm 1"
  date     DateTime
  maxMarks Float        @default(100)
  courseId String
  course   Course       @relation(fields: [courseId], references: [id])
  results  ExamResult[]
}

model ExamResult {
  id            String         @id @default(uuid())
  marksObtained Float
  examId        String
  exam          Exam           @relation(fields: [examId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
}

// ==========================================
// MODULE G: COMPLAINTS & MAINTENANCE
// ==========================================

model Complaint {
  id          String          @id @default(uuid())
  title       String
  description String
  location    String?
  status      ComplaintStatus @default(OPEN)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// ==========================================
// MODULE J: NOTIFICATIONS
// ==========================================

model Notification {
  id      String  @id @default(uuid())
  title   String
  message String
  type    String  @default("SYSTEM") // SYSTEM, ALERT, MESSAGE
  isRead  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ==========================================
// TEAM 2: CAREER ENTITIES
// ==========================================

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentSkills StudentSkill[]
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiencyLevel String // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  isVerified       Boolean        @default(false)

  @@unique([studentId, skillId])
}

model CareerGoal {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole     String
  targetIndustry String
  isActive       Boolean        @default(true)
}

model CareerAssessment {
  id               String             @id @default(uuid())
  title            String
  description      String
  type             String             @default("TECHNICAL")
  durationMinutes  Int                @default(30)
  results          AssessmentResult[]
}

model AssessmentResult {
  id           String           @id @default(uuid())
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   CareerAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score        Float
  aiFeedback   Json
  createdAt    DateTime         @default(now())
}

model CareerRecommendation {
  id              String         @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recommendedRole String
  matchPercentage Float
  rationale       String
}

model LearningResource {
  id    String @id @default(uuid())
  title String
  url   String
  type  String
}

model ProjectSuggestion {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  difficulty  String
}

model Resume {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl   String
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  analysis     ResumeAnalysis?
  applications JobApplication[]
}

model ResumeAnalysis {
  id         String   @id @default(uuid())
  resumeId   String   @unique
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  atsScore   Float
  feedback   Json
  analyzedAt DateTime @default(now())
}

// ==========================================
// TEAM 2: PLACEMENT ENTITIES
// ==========================================

model Company {
  id                 String @id @default(uuid())
  name               String @unique
  website            String
  industry           String
  verificationStatus String @default("PENDING_VERIFICATION") // REGISTERED, PENDING_VERIFICATION, VERIFIED, ACTIVE

  recruiters Recruiter[]
  drives     PlacementDrive[]
}

model Recruiter {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation String
  isVerified  Boolean @default(false)
}

model PlacementDrive {
  id                   String   @id @default(uuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                String
  description          String
  status               String   @default("DRAFT") // DRAFT, PUBLISHED, ONGOING, COMPLETED
  registrationDeadline DateTime

  jobs Job[]
}

model Job {
  id             String         @id @default(uuid())
  driveId        String
  drive          PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  packageDetails String
  location       String
  skills         String[]
  selectionSteps String[]

  eligibility  EligibilityRule?
  applications JobApplication[]
}

model EligibilityRule {
  id              String   @id @default(uuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  minCgpa         Float
  allowedBranches String[]
  maxBacklogs     Int
}

model JobApplication {
  id                 String         @id @default(uuid())
  jobId              String
  job                Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resumeId           String
  resume             Resume         @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  status             String         @default("APPLIED") // APPLIED, SHORTLISTED, INTERVIEW, SELECTED, REJECTED
  assessmentScore    Float?
  assessmentFeedback String?

  shortlist       Shortlist?
  interviews      Interview[]
  selectionResult SelectionResult?

  @@unique([jobId, studentId])
}

model Shortlist {
  id            String         @id @default(uuid())
  applicationId String         @unique
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundNumber   Int
}

model Interview {
  id            String         @id @default(uuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  type          String
  feedback      String?
}

model SelectionResult {
  id             String         @id @default(uuid())
  applicationId  String         @unique
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offerLetterUrl String?
  accepted       Boolean?
}

// ==========================================
// TEAM 2: ALUMNI ENTITIES
// ==========================================

model AlumniProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  graduationYear Int
  currentCompany String?
  currentRole    String?
  linkedInUrl    String?
  expertise      String[]

  requestsReceived MentorshipRequest[]
  opportunities    AlumniOpportunity[]
}

model MentorshipRequest {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  alumniId  String
  alumni    AlumniProfile  @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  status    String         @default("PENDING") // PENDING, ACCEPTED, REJECTED
  message   String

  sessions MentorshipSession[]
}

model MentorshipSession {
  id          String            @id @default(uuid())
  requestId   String
  request     MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  meetingLink String
}

model AlumniOpportunity {
  id              String        @id @default(uuid())
  alumniId        String
  alumni          AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  title           String
  description     String
  applicationLink String
  isActive        Boolean       @default(true)

  referrals Referral[]
}

model Referral {
  id            String            @id @default(uuid())
  studentId     String
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   AlumniOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        String            @default("REQUESTED") // REQUESTED, REFERRED, DECLINED
}

model AlumniEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
}

// ==========================================
// TEAM 3: MOCK INTERVIEW ENTITIES
// ==========================================

model MockInterview {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String // AI, Alumni
  status      String         @default("SCHEDULED")
  feedback    Json?
  aiSessionId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
