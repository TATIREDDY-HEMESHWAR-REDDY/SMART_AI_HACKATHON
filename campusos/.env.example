# Copy this file to .env.local, then enter your organisation's SMTP mailbox credentials.
APP_URL=http://localhost:3001
MAIL_FROM="CampusOS Admin <admin@yourcollege.edu>"
SMTP_HOST=smtp.your-provider.edu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@yourcollege.edu
SMTP_PASSWORD=replace-with-an-app-password
