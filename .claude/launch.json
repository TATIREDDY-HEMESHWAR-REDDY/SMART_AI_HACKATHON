{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "campusos-erp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "campusos", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "career-os-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "career-os",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
